# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/wcclanding?retryWrites=true&w=majority

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-32-character-secret-here

# Initial Admin User Credentials (used by scripts/seedAdmin.js)
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@whitecoatclub.com
ADMIN_PASSWORD=change_this_to_a_secure_password_8chars

# AWS S3 Storage for File & Image Uploads
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=your-wcc-bucket-name

# Email / SMTP Configuration (Nodemailer)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=your-email@example.com
EMAIL_SERVER_PASSWORD=your-smtp-app-password
EMAIL_FROM="White Coat Club" <noreply@whitecoatclub.com>
